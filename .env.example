# DeepAgents 环境变量配置模板
# 使用: cp .env.example .env 然后编辑 .env 填入真实值

# ── LLM 大模型（必填） ──
OPENAI_API_KEY=your-llm-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_MODEL=deepseek-chat

# ── 搜索引擎（必填，Tavily） ──
# 在 https://app.tavily.com/ 注册账号创建 API KEY
TAVILY_API_KEY=your-tavily-api-key-here

# ── Embedding 模型 ──
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deepagents
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DATABASE=deepagents
DB_POOL_MIN_SIZE=3
DB_POOL_MAX_SIZE=15
DB_COMMAND_TIMEOUT=30

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ── JWT 认证 ──
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOURS=24

# ── MySQL（教学演示数据库） ──
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=deepsearch_demo

# ── CORS ──
CORS_ORIGINS=http://localhost:5173

# ── 文件上传 ──
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.txt,.csv,.md,.pdf,.docx,.xlsx,.png,.jpg,.jpeg,.gif,.json

# ── 任务治理 ──
MAX_CONCURRENT_TASKS_PER_USER=3
TASK_TIMEOUT_SECONDS=300

# ── 数据保留 ──
SESSION_RETENTION_DAYS=90

# ── LDAP 认证（可选，不配则不启用）──
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_RDN=cn=users,cn=accounts
# LDAP_USERNAME_ATTR=uid
# LDAP_EMAIL_ATTR=mail
# LDAP_USE_TLS=false

# ── OIDC SSO（可选，不配则不启用）──
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
