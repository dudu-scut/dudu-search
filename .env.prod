# ═══════════════════════════════════════════════════════════════
# DeepAgents 生产环境配置模板
# ═══════════════════════════════════════════════════════════════
# 使用方法:
#   1. 复制此文件并填入真实值
#   2. docker compose -f docker-compose.prod.yaml up -d
# ═══════════════════════════════════════════════════════════════

# ── LLM（必填） ──
# 支持 DeepSeek / OpenAI 兼容 API
LLM_API_KEY=your-real-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Embedding 模型 ──
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ── Tavily 搜索（建议填写） ──
TAVILY_API_KEY=your-tavily-key

# ── 数据库密码 ──
POSTGRES_USER=deepagents
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=deepagents

# ── Redis 密码 ──
REDIS_PASSWORD=your-strong-redis-password

# ── JWT（生产务必修改） ──
JWT_SECRET=your-random-secret-at-least-32-chars

# ── MySQL（教学数据库，供 db_tools 使用） ──
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=deepsearch_demo

# ── 日志 ──
# console = 彩色开发模式 | json = 结构化生产模式
LOG_FORMAT=json

# ── CORS ──
# 生产环境填写实际前端域名，逗号分隔
CORS_ORIGINS=http://localhost:5173

# ── 端口 ──
NGINX_PORT=80
